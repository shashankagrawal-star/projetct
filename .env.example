# Copy to .env for local use. NEVER commit real values.
# In hosting, set these in the platform's environment-variable settings.

# --- server ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info                      # fatal | error | warn | info | debug | trace | silent
DATABASE_PATH=./data/runtime/app.db # SQLite file; use :memory: for a throwaway instance
# DATA_DIR=./data                   # schemas + bounded sample + target seed
# WEB_DIST=./web/dist               # built frontend served by the API process

# --- dataset bounds / execution ---
MAX_SAMPLE_SIZE=500                 # documented maximum; the server refuses to start with a larger sample
EXECUTION_BATCH_SIZE=25             # records per committed batch during execution
ALLOW_FAILURE_INJECTION=true        # lets a reviewer simulate a target failure to try retry/recovery

# --- AI agent ---
# auto      = Claude agent if ANTHROPIC_API_KEY is set, otherwise the rule-based fallback engine
# llm       = require the Claude agent (agent runs fail with 503 if no key)
# heuristic = always use the rule-based engine (no network calls)
AGENT_MODE=auto
ANTHROPIC_API_KEY=                  # required for the LLM agent; leave empty to use the fallback engine
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium             # low | medium | high | xhigh | max
ANTHROPIC_SERVER_FALLBACKS=true     # opt in to server-side refusal fallbacks (auto-disabled if the API rejects them)
AGENT_MAX_ITERATIONS=16             # tool-use turns before a run is abandoned
AGENT_MAX_TOKENS=16000
AGENT_RUN_LIMIT_PER_HOUR=20         # cost guard for a public deployment
